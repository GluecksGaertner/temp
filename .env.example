# Required: Google Maps Platform API key
# Create one at https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=AIza...

# Transport: "stdio" (default, local) or "http" (remote / phone app)
TRANSPORT=stdio

# --- HTTP transport only ---
# Port to listen on (Cloud Run / Railway / Fly set this automatically)
PORT=3000

# Shared secret. Strongly recommended when the server is reachable from the
# internet. Clients may pass it as "Authorization: Bearer <token>" or as a URL
# path segment: https://your-host/mcp/<token>
MCP_AUTH_TOKEN=

# Comma-separated list of allowed Origin headers (DNS-rebinding protection).
# Leave empty to allow requests without an Origin header only.
ALLOWED_ORIGINS=https://claude.ai,https://www.claude.ai

# Optional defaults applied when a tool call omits them
DEFAULT_LANGUAGE=de
DEFAULT_REGION=de
